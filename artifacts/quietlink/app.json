{
  "expo": {
    "name": "QuietLink Messenger",
    "slug": "quietlink",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "quietlink",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#F4F7F6",
      "image": "./assets/images/icon.png",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "deploymentTarget": "15.1"
    },
    "android": {
      "minSdkVersion": 24
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true,
          "ios": {
            "useSQLCipher": true
          },
          "android": {
            "useSQLCipher": true
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "react-native-libsodium",
        {}
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "QuietLink uses the microphone for voice notes and voice calls.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "QuietLink accesses selected photos and videos only when you choose an attachment.",
          "cameraPermission": "QuietLink uses the camera when you explicitly choose a camera feature.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "quietlink-alerts",
          "sounds": []
        }
      ]
    ],
    "newArchEnabled": true,
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
