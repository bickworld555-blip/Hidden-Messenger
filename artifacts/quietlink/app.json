{
  "expo": {
    "name": "Hidden Messenger",
    "slug": "quietlink",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "quietlink",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "deploymentTarget": "15.1",
      "infoPlist": {
        "CFBundleName": "Hidden Messenger",
        "CFBundleDisplayName": "Hidden Messenger"
      }
    },
    "android": {
      "package": "com.hiddenmessenger.app",
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "output": "static",
      "splash": {
        "backgroundColor": "#F4F7F6",
        "image": "./assets/images/icon.png",
        "resizeMode": "contain"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F7F6",
          "image": "./assets/images/icon.png",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true,
          "ios": {
            "useSQLCipher": true
          },
          "android": {
            "useSQLCipher": true
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      ["react-native-libsodium", {}],
      [
        "expo-audio",
        {
          "microphonePermission": "Hidden Messenger requests microphone access only for audio features you choose.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Hidden Messenger uses the camera to scan secure call pairing codes and for video calls.",
          "microphonePermission": "Hidden Messenger uses the microphone only during calls you accept.",
          "barcodeScannerEnabled": true
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Hidden Messenger uses the camera to scan secure call pairing codes and for video calls.",
          "microphonePermission": "Hidden Messenger uses the microphone only during calls you accept."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Hidden Messenger accesses selected photos and videos only when you choose an attachment.",
          "cameraPermission": "Hidden Messenger requests camera access only when you choose a camera feature.",
          "microphonePermission": false
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Hidden Messenger reads contact names and phone numbers on this device only to show your contacts and prepare invitations."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "quietlink-alerts",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
